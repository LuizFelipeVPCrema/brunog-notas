# Copie para .env e troque os valores:  cp .env.example .env

# Porta em que o site fica disponível na VPS
HTTP_PORT=80

# Senha do Postgres (só usada entre os containers)
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Segredo dos tokens de login (mín. 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=

# Administrador do sistema (senha com 12+ caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Professor
TEACHER_USERNAME=Brunog
TEACHER_PASSWORD=resultadosbimestre
TEACHER_NAME=Prof. Bruno Gomes

# Nota máxima do bimestre
MAX_TOTAL=10
